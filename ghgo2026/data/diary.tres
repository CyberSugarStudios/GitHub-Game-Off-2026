script = ExtResource("1_mh00m")
pages = Array[String](["[font=res://assets/fonts/Caveat-Regular.ttf]An ordinary day. School, parents, friends drifting.[/font]", "[font=res://assets/fonts/Caveat-Regular.ttf]Mom and Dad are fighting about money again.[/font]", "[font=res://assets/fonts/Caveat-Regular.ttf]Bullying starts at school.[/font]", "[font=res://assets/fonts/Caveat-Regular.ttf]Dad said he'd take me to the gun range and gave me the code to the safe. He said \"just in case\" a lot.[/font]", "[font=res://assets/fonts/Caveat-Regular.ttf]Burnout, grades declining, feeling invisible.[/font]", "[font=res://assets/fonts/ReenieBeanie-Regular.ttf]Mom found my weed. Called me stupid, spoiled, a lot cause.[/font]", "[font=res://assets/fonts/ReenieBeanie-Regular.ttf]As many more entries as needed to convey story, decline, and trauma.[/font]", "[font=res://assets/fonts/ReenieBeanie-Regular.ttf]Last entry. Handle with care. :([/font]"])
