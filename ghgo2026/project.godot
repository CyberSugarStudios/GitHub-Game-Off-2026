; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Interim"
config/version="0.9.5"
run/main_scene="res://scenes/ui/content_warning.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="uid://usg3cs6ey547"
config/playtest_build=1

[audio]

buses/default_bus_layout="res://data/default_bus_layout.tres"
general/default_playback_type.web=0

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Events="*res://scripts/autoload/events.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Music="*res://scripts/autoload/music.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Powers="*res://scripts/autoload/powers.gd"
DebugKeys="*res://scripts/autoload/debug_keys.gd"
Playtest="*res://scripts/autoload/playtest.gd"
Settings="*res://scripts/autoload/settings.gd"
ScreenGrade="*res://scripts/autoload/screen_grade.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="C:/Users/Jordon/Downloads/hand_anim_demo.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/version_tools/plugin.cfg")

[gui]

theme/custom="res://resources/interim_main_theme.tres"
theme/custom_font="res://assets/fonts/JosefinSans-VariableFont_wght.ttf"

