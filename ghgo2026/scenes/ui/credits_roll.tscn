text = "[center][font=res://assets/fonts/Allura-Regular.ttf][font_size=240]Interim[/font_size][/font]
[font_size=28][b]Made for the GitHub Game Off 2026[/b][/font_size]


[font=res://assets/fonts/Allura-Regular.ttf][font_size=80]Team[/font_size][/font]
[font_size=28][b]Jordon Call[/b] — Lead Developer and Systems Designer
[b]Charlie Vaughn[/b] — Creative Director
[b]Phrenix[/b] — Animator
[b]Sunny Bee[/b] — Character Artist
[b]KatyaArt132[/b] — Cinematics Artist
[b]Lee Campos[/b] — Background Artist
[b]Rhys Cassidy[/b] — Composer
[b]Jura[/b] — Folley Artist
[b]Robert Burchette[/b] — Communications Moderator[/font_size]


[font=res://assets/fonts/Allura-Regular.ttf][font_size=80]Voice Actors[/font_size][/font]
[font_size=28][b]Sunny Bee[/b] as Emily Dunn
[b]Ry Hillemeyer[/b] as David Dunn
[b]Bella Hillemeyer[/b] as Leanne Dunn


[font=res://assets/fonts/Allura-Regular.ttf][font_size=80]Featured Music[/font_size][/font]
[font_size=30][b]Faye Ophelia[/b]
\"Luna\" · \"Card Towers\" · \"Swallowtail\" · \"Anathema\"[/font_size]
[font_size=20][i]Used with the artist's permission.[/i][/font_size]

[font_size=30][b]Joe Leytrick[/b]
\"In the Dark\" · \"I Don't Know (Acoustic)\" · \"Forget the Day\"[/font_size]
[font_size=20][i]Used with the artist's permission.[/i][/font_size]

[font_size=30][b]Ayleen Valentine[/b]
\"White Gummy\"[/font_size]
