[node name="HelpText" type="RichTextLabel" parent="." unique_id=457808753]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = -1
anchor_top = 4.5644445
anchor_right = 1.0
anchor_bottom = 5.2755556
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "
[color=cccdc4][center][font_size=30][b][i]If this story touched something in you...[/i][/b]

Emily's story is fiction, but the feelings in it are real for a lot of people.
If you are thinking about suicide, or you are worried about someone, please reach out.
You are not a burden, and you are not alone.

[center]
[table=2]
[cell padding=0,0,24,0][right][b]United States[/b][/right][/cell][cell][left]Call or text 988, or text HOME or HOLA to 741741[/left][/cell]
[cell padding=0,0,24,0][right][b]Canada[/b][/right][/cell][cell][left]Call or text 988[/left][/cell]
[cell padding=0,0,24,0][right][b]UK & Ireland[/b][/right][/cell][cell][left]Call Samaritans, 116-123[/left][/cell]
[cell padding=0,0,24,0][right][b]Australia[/b][/right][/cell][cell][left]Call Lifeline at 13-11-14, text 0477-13-11-14, or visit lifeline.org.au[/left][/cell]
[cell padding=0,0,24,0][right][b]Anywhere else[/b][/right][/cell][cell][left]Findahelpline.com[/left][/cell]
[/table]
[/center]
If you are in immediate danger, call your local emergency number.
If there is a gun in your home, storing it locked, unloaded, and apart from ammunition saves lives.
[/font_size]

[font_size=30][b][i]Thank you for playing our game[/i].[/b][/font_size][/center]
"
fit_content = true
scroll_active = false
