[cell padding=0,0,24,0][right][b]KatyaArt132[/b][/right][/cell][cell][left]Character & Cinematic Artist[/left][/cell]
[cell padding=0,0,24,0][right][b]Lee Campos[/b][/right][/cell][cell][left]Background & Prop Artist[/left][/cell]
[cell padding=0,0,24,0][right][b]Rhys Cassidy[/b][/right][/cell][cell][left]Composer[/left][/cell]
[cell padding=0,0,24,0][right][b]Jura Leopold[/b][/right][/cell][cell][left]Foley Artist[/left][/cell]
[cell padding=0,0,24,0][right][b]Robert Burchette[/b][/right][/cell][cell][left]Communications & Playtest Coordinator[/left][/cell]
[/table]
[/center]
