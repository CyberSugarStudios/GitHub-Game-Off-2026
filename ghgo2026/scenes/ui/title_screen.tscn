text = "
[font=res://assets/fonts/Allura-Regular.ttf][font_size=80][color=70afa3]Development Team[/color][/font_size][/font]
[font_size=30]
[center]
[table=2]
[cell padding=0,0,24,0][right][b]Jordon Call[/b][/right][/cell][cell][left]Lead Developer & Systems Designer[/left][/cell]
[cell padding=0,0,24,0][right][b]Charlie Vaughn[/b][/right][/cell][cell][left]Creative Director & Executive Producer[/left][/cell]
[cell padding=0,0,24,0][right][b]Phrenix[/b][/right][/cell][cell][left]Art Director & Animator[/left][/cell]
[cell padding=0,0,24,0][right][b]Sunny Bee[/b][/right][/cell][cell][left]Character & Prop Artist[/left][/cell]
[cell padding=0,0,24,0][right][b]KatyaArt132[/b][/right][/cell][cell][left]Character & Cinematic Artist[/left][/cell]
[cell padding=0,0,24,0][right][b]Lee Campos[/b][/right][/cell][cell][left]Background & Prop Artist[/left][/cell]
[cell padding=0,0,24,0][right][b]Rhys Cassidy[/b][/right][/cell][cell][left]Composer[/left][/cell]
[cell padding=0,0,24,0][right][b]Jura Leopold[/b][/right][/cell][cell][left]Foley Artist[/left][/cell]
[cell padding=0,0,24,0][right][b]Robert Burchette[/b][/right][/cell][cell][left]Communications & Playtest Coordinator[/left][/cell]
[/table]
[/center]
[/font_size]
[font=res://assets/fonts/Allura-Regular.ttf][font_size=80][color=70afa3]Voice Actors[/color][/font_size][/font]
